{
  "name": "@kouts/vue-simple-dropdown",
  "description": "A Vue.js 3 simple dropdown component.",
  "version": "0.0.0-semantic-release",
  "license": "MIT",
  "repository": "https://github.com/kouts/vue-simple-dropdown",
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "author": "Giannis Koutsaftakis",
  "keywords": [
    "dropdown",
    "menu",
    "floating-vue"
  ],
  "main": "./dist/vue-simple-dropdown.umd.js",
  "module": "./dist/vue-simple-dropdown.es.js",
  "types": "./dist/SimpleDropdown.vue.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-simple-dropdown.es.js",
      "require": "./dist/vue-simple-dropdown.umd.js"
    }
  },
  "unpkg": "dist/vue-simple-dropdown.umd.js",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build:vite": "vue-tsc --noEmit && vite build",
    "build": "npm run build:vite",
    "build-playground": "BUILD_MODE=playground npm run build:vite",
    "preview": "vite preview",
    "lint": "eslint \"**/*.{vue,ts,js}\"",
    "lint-fix": "eslint --fix \"**/*.{vue,ts,js}\"",
    "test:unit": "jest",
    "test:unit-coverage": "jest --coverage && make-coverage-badge",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@kouts/eslint-config": "^3.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.0",
    "floating-vue": "^5.2.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.6",
    "make-coverage-badge": "^1.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-delete": "^3.0.1",
    "sass": "^1.93.3",
    "tailwindcss": "^3.2.4",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.2"
  },
  "peerDependencies": {
    "floating-vue": "^2.0.0-beta.20"
  }
}